    {
      "type": "table",
      "title": "Traces recentes de solicitação",
      "description": "Clique no trace ID: abre a cascata BFF → crédito → Kafka → risco → antifraude.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"bff\" && span.http.route = \"/v1/solicitacoes\" }",
