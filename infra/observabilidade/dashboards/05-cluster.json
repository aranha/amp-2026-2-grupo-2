    {
      "type": "table",
      "title": "Instâncias de cada serviço",
      "description": "Uma linha por processo: depois de um self-healing o ID da instância muda.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count by (job, service_instance_id) (target_info{job!~\"otel-collector|kafka|postgres|tempo|servicos-java\"})",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "job": "Serviço",
              "service_instance_id": "Instância",
              "Value": "Séries"
            },
            "indexByName": {
              "job": 0,
              "service_instance_id": 1,
              "Value": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
